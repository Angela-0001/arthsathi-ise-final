# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arthsathi

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# DigiLocker / KYC (sandbox)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:8000/auth/digilocker/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Twilio (WhatsApp webhook receiving only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Our own ML services (arthsathi-ml)
# Start translation API with: uvicorn translation.serve:app --port 5001
TRANSLATION_API_URL=http://localhost:5001

# Paths to arthsathi-ml artifacts (relative to backend/)
SCHEME_RECOMMENDER_PATH=../arthsathi-ml/models/scheme_recommender/artifacts
INSURANCE_RECOMMENDER_PATH=../arthsathi-ml/models/insurance_recommender/artifacts
LM_CHECKPOINT_PATH=../arthsathi-ml/language_model/checkpoints/best_lm.pt
VOSK_MODEL_PATH=../arthsathi-ml/speech/models/vosk

# myScheme pipeline
MYSCHEME_BASE_URL=https://www.myscheme.gov.in
